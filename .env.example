LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=${OPENAI_API_KEY}
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60

# metadata | redacted | full
EVENT_CAPTURE_MODE=redacted
EVENT_FILE=/data/security-events.jsonl

# Agent and Judge models are intentionally configured separately.
JUDGE_ENABLED=false
JUDGE_PROVIDER=openai-compatible
JUDGE_BASE_URL=https://api.openai.com
JUDGE_API_KEY=${OPENAI_API_KEY}
JUDGE_MODEL=gpt-4o-mini
JUDGE_TIMEOUT_SECONDS=10
JUDGE_WARN_THRESHOLD=0.40
JUDGE_BLOCK_THRESHOLD=0.75
JUDGE_FAILURE_MODE=warn
JUDGE_JSON_MODE=true

LLM_PROVIDER=mock
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=unused
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60
